---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section>
    <div class="narrow" style="text-align:center">
      <div class="call">Call number not found</div>
      <h1 style="margin:12px 0 18px">404</h1>
      <p class="lede" style="margin-inline:auto">That page isn't on any shelf. It may have moved when the library was rebuilt.</p>
      <div style="margin-top:24px;display:flex;gap:10px;justify-content:center"><a href="/" class="btn solid">Home</a><a href="/search/" class="btn">Search</a></div>
    </div>
  </section>
</Base>
